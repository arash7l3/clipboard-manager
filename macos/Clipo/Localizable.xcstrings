{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and %lld more" : {
      "comment" : "Popup row title of several copied files: the first file's name and how many others",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ و %2$lld مورد دیگر"
          }
        }
      }
    },
    "%@ · %@" : {
      "comment" : "Popup row details: the app an item was copied from, then how long ago",
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld items in history" : {
