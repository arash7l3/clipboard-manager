<!--
  The Clipo app: WinUI 3 on the Windows App SDK, unpackaged for now (MSIX
  comes in step 5.3). The Windows App SDK is bundled with the app
  (self-contained), so nothing has to be installed to run it.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 (decision 0002). -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Clipo</RootNamespace>
    <AssemblyName>Clipo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Builds resources.pri from Strings/, which unpackaged apps need too. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ClipoCopiesNativeLibrary>true</ClipoCopiesNativeLibrary>
    <!-- LibraryImport generates unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Clipo.Services/Clipo.Services.csproj" />
  </ItemGroup>

</Project>
