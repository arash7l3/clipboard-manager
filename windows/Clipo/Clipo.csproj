<!--
  The Clipo app: WinUI 3 on the Windows App SDK. By default it is unpackaged
  (a folder or zip); windows/scripts/make-msix.ps1 builds the MSIX package
  with -p:WindowsPackageType=MSIX (decision 0025). The Windows App SDK is
  bundled with the app (self-contained), so nothing has to be installed.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Windows 11 (decision 0002). -->
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Clipo</RootNamespace>
    <AssemblyName>Clipo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Clipo.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Builds resources.pri from Strings/, which unpackaged apps need too. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ClipoCopiesNativeLibrary>true</ClipoCopiesNativeLibrary>
    <!-- LibraryImport generates unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The tray icon and the window icon are loaded from these files at run time. -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'MSIX'">
    <None Update="Clipo.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ClipoPrivate.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- A package holds Content items, not None items. -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <None Remove="Clipo.ico;ClipoPrivate.ico" />
    <Content Include="Clipo.ico;ClipoPrivate.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The package's logos, named in Package.appxmanifest. Package.appxmanifest itself is found by convention. -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <Content Include="Assets\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Clipo.Services/Clipo.Services.csproj" />
  </ItemGroup>

</Project>
