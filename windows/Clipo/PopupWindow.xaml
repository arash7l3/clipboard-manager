<?xml version="1.0" encoding="utf-8"?>
<!--
  The history popup: a search field, category tabs and the list of items.
  The search field keeps the keyboard; see PopupWindow.xaml.cs.
-->
<Window
    x:Class="Clipo.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clipo"
    Title="Clipo">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" x:Uid="SearchBox" IsSpellCheckEnabled="False"
                 TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />

        <!-- Tab and Shift+Tab in the search field switch tabs, so the bar never takes the keyboard. -->
        <SelectorBar x:Name="Tabs" x:Uid="Tabs" Grid.Row="1" IsTabStop="False" SelectionChanged="OnTabChanged">
            <SelectorBarItem x:Uid="TabAll" IsSelected="True" />
            <SelectorBarItem x:Uid="TabText" />
            <SelectorBarItem x:Uid="TabImages" />
            <SelectorBarItem x:Uid="TabFiles" />
            <SelectorBarItem x:Uid="TabPinned" />
        </SelectorBar>

        <ListView x:Name="HistoryList" x:Uid="HistoryList" Grid.Row="2"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick"
                  IsTabStop="False" AllowFocusOnInteraction="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PopupRow">
                    <Grid Height="48" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Visibility="{x:Bind GlyphVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image Source="{x:Bind Thumbnail}" Width="32" Height="32" Stretch="Uniform"
                               Visibility="{x:Bind ThumbnailVisibility}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE718;" FontSize="12" Visibility="{x:Bind PinVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
