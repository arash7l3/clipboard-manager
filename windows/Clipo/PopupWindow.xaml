<?xml version="1.0" encoding="utf-8"?>
<!--
  The history popup: a search field, category tabs and the list of items.
  Nothing in it takes the focus: the app underneath keeps it, and the
  popup's keys reach it another way; see PopupWindow.xaml.cs.
-->
<Window
    x:Class="Clipo.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Clipo"
    Title="Clipo">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Shows the search typed into the popup; read-only, because it never has the focus. -->
        <TextBox x:Name="SearchBox" x:Uid="SearchBox" IsSpellCheckEnabled="False" IsReadOnly="True"
                 IsTabStop="False" AllowFocusOnInteraction="False" IsHitTestVisible="False" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Tab and Shift+Tab switch tabs, so the bar never takes the keyboard. -->
            <SelectorBar x:Name="Tabs" x:Uid="Tabs" IsTabStop="False" AllowFocusOnInteraction="False" SelectionChanged="OnTabChanged">
                <SelectorBarItem x:Uid="TabAll" IsSelected="True" AllowFocusOnInteraction="False" />
                <SelectorBarItem x:Uid="TabText" AllowFocusOnInteraction="False" />
                <SelectorBarItem x:Uid="TabImages" AllowFocusOnInteraction="False" />
                <SelectorBarItem x:Uid="TabFiles" AllowFocusOnInteraction="False" />
                <SelectorBarItem x:Uid="TabPinned" AllowFocusOnInteraction="False" />
            </SelectorBar>

            <!-- Clears the tab; the first click arms it and a second one within a few seconds clears. -->
            <Button x:Name="ClearButton" Grid.Column="1" VerticalAlignment="Center" MinWidth="40"
                    IsTabStop="False" AllowFocusOnInteraction="False" Click="OnClearClick">
                <Grid>
                    <!-- Drawn, not a font glyph: when Clipo starts at sign-in the icon font may not be ready, and the glyph stayed blank. -->
                    <Path x:Name="ClearIcon" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                          Data="M5.5 2.5H10.5 M2 4H14 M3.5 4L4.2 13.2A1 1 0 0 0 5.2 14H10.8A1 1 0 0 0 11.8 13.2L12.5 4 M6.5 6.5V11.5 M9.5 6.5V11.5" />
                    <TextBlock x:Name="ClearConfirm" x:Uid="ClearConfirm" Visibility="Collapsed"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </Grid>
            </Button>
        </Grid>

        <!-- Shown while private mode is on, so nothing is copied into the history unawares. -->
        <TextBlock x:Name="PrivateNote" x:Uid="PrivateNote" Grid.Row="2" Style="{StaticResource CaptionTextBlockStyle}"
                   TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource SystemFillColorCautionBrush}" />

        <ListView x:Name="HistoryList" x:Uid="HistoryList" Grid.Row="3"
                  SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnItemClick" RightTapped="OnRowRightTapped"
                  IsTabStop="False" AllowFocusOnInteraction="False">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PopupRow">
                    <Grid Height="48" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Visibility="{x:Bind GlyphVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Image Source="{x:Bind Thumbnail}" Width="32" Height="32" Stretch="Uniform"
                               Visibility="{x:Bind ThumbnailVisibility}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"
                                    Visibility="{x:Bind LinesVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Shortcut}" Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon Grid.Column="3" Glyph="&#xE718;" FontSize="12" Visibility="{x:Bind PinVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- The new name while the row is renamed; typed through the popup's keys, so it never has the focus. -->
                        <TextBox Grid.Column="1" VerticalAlignment="Center" IsSpellCheckEnabled="False"
                                 IsReadOnly="True" IsTabStop="False" AllowFocusOnInteraction="False" IsHitTestVisible="False"
                                 Text="{x:Bind RenameShown, Mode=OneWay}" PlaceholderText="{x:Bind RenameHint}"
                                 Visibility="{x:Bind RenameVisibility, Mode=OneWay}"
                                 SelectionHighlightColorWhenNotFocused="{ThemeResource TextControlSelectionHighlightColor}" />
                        <!-- Rename and delete this item. Drawn, not font glyphs, like the Clear button. -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                            <Button Padding="6" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" AllowFocusOnInteraction="False" Click="OnRenameClick"
                                    ToolTipService.ToolTip="{x:Bind RenameLabel}" AutomationProperties.Name="{x:Bind RenameLabel}">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                      Data="M10.5 2.5L13.5 5.5L5.5 13.5H2.5V10.5Z M9 4L12 7" />
                            </Button>
                            <Button Padding="6" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                    IsTabStop="False" AllowFocusOnInteraction="False" Click="OnDeleteClick"
                                    ToolTipService.ToolTip="{x:Bind DeleteLabel}" AutomationProperties.Name="{x:Bind DeleteLabel}">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                      Data="M5.5 2.5H10.5 M2 4H14 M3.5 4L4.2 13.2A1 1 0 0 0 5.2 14H10.8A1 1 0 0 0 11.8 13.2L12.5 4 M6.5 6.5V11.5 M9.5 6.5V11.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyText" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
