<?xml version="1.0" encoding="utf-8"?>
<!--
  A small status window: the history's state and Try Again. The tray icon
  (step 3.2) takes over as the app's main surface.
-->
<Window
    x:Class="Clipo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clipo">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <StackPanel x:Name="Root" Padding="24" Spacing="12" VerticalAlignment="Center">
        <StackPanel Spacing="2">
            <TextBlock Text="Clipo" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="AppSubtitle" Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <!-- Announced by screen readers when it changes. -->
        <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}"
                   AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="TryAgainButton" x:Uid="TryAgainButton" Visibility="Collapsed" Click="OnTryAgain" />
    </StackPanel>
</Window>
